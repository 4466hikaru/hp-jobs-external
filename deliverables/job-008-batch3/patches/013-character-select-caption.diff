+func _center_character_select_button_caption(button: Button) -> void:
+	# 戻る / 出撃する sit on the top edge of the approved plate. Button has no
+	# vertical text alignment; extra top pad drops CJK glyphs onto the plate center.
+	if button == null:
+		return
+	var plate := StyleBoxEmpty.new()
+	var extra_top := maxf(16.0, floorf((button.size.y - 16.0) * 0.28))
+	plate.content_margin_left = 8.0
+	plate.content_margin_right = 8.0
+	plate.content_margin_top = extra_top
+	plate.content_margin_bottom = maxf(6.0, extra_top - 10.0)
+	for style_name in ["normal", "hover", "pressed", "disabled", "focus"]:
+		button.add_theme_stylebox_override(style_name, plate)
+
