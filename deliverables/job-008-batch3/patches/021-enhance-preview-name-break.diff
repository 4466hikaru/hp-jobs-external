+func _join_names_without_mid_break(names: Array) -> String:
+	var parts: PackedStringArray = []
+	for value in names:
+		var name := str(value)
+		if name.is_empty():
+			continue
+		parts.append(_prohibit_mid_word_break(name))
+	return " / ".join(parts)
+
+
+func _prohibit_mid_word_break(text: String) -> String:
+	# WORD JOINER keeps CJK names such as リリカ from wrapping mid-name.
+	if text.length() <= 1:
+		return text
+	var chars: PackedStringArray = []
+	for index in range(text.length()):
+		chars.append(text.substr(index, 1))
+	return char(0x2060).join(chars)
+
+
