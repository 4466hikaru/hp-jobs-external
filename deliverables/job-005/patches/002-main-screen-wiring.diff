+func _nudge_approved_b2_volume(setting_key: String, delta: float) -> void:
+	var settings := _settings_data()
+	var current := clampf(float(settings.get(setting_key, 0.8)), 0.0, 1.0)
+	var next := current + delta
+	if next > 1.0:
+		next = 0.0
+	settings[setting_key] = next
+	save_data["settings"] = settings
+	_apply_saved_settings()
+	audio_suppress_save_se = true
+	_write_save_data()
+	audio_suppress_save_se = false
+	_show_options(options_return_target)
