+func _show_title_image2_menu(slot_summary: Dictionary) -> bool:
+	var can_continue := str(slot_summary.get("state", SAVE_SLOT_STATE_EMPTY)) == SAVE_SLOT_STATE_READY
+	var view := TitleImage2Layout.build_view({
+		"title": _localized_text("ui.boot_splash.title"),
+		"subtitle": _localized_text("ui.title.tagline"),
+		"actions": [
+			_localized_text("ui.title.new_game"),
+			_localized_text("ui.title.continue"),
+			_localized_text("ui.save_load.menu_button"),
+			"設定",
+			"クレジット",
+		],
+		"disabled": [false, not can_continue, false, false, false],
+	})
+	if not _install_approved_ui_wiring_b1_view(&"title", view):
+		return false
+	var new_game := _bind_approved_ui_wiring_b1_action(view, TitleImage2Layout.action_node_name(0), Callable(self, "_on_title_new_game_pressed"))
+	_bind_approved_ui_wiring_b1_action(view, TitleImage2Layout.action_node_name(1), Callable(self, "_continue_from_title"), not can_continue)
+	_bind_approved_ui_wiring_b1_action(view, TitleImage2Layout.action_node_name(2), Callable(self, "_transition_to_save_load_menu").bind("title"))
+	_bind_approved_ui_wiring_b1_action(view, TitleImage2Layout.action_node_name(3), Callable(self, "_transition_to_options").bind("title"))
+	_bind_approved_ui_wiring_b1_action(view, TitleImage2Layout.action_node_name(4), Callable(self, "_on_title_credits_pressed"))
+	_add_battle_profile_dev_selector(view)
+	_focus_approved_ui_wiring_b1_button(new_game)
+	return true
+
+
+func _on_title_credits_pressed() -> void:
+	_transition_to_credits_license()
+	# _transition_to_credits_license clears this; restore so title can return here.
+	credits_return_to_title = true
+
+
 func _add_battle_profile_dev_selector(view: Control) -> void:
