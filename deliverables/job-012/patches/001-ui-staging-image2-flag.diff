+func _configure_ui_staging_arg(args: PackedStringArray) -> void:
+	# Same style as --store-target: --ui-staging=image2 or --ui-staging image2.
+	# Absent / empty / unknown value leaves ui_staging_mode empty (current path).
+	for arg_index in range(args.size()):
+		var value := str(args[arg_index])
+		if value == "--ui-staging":
+			var next_value := ""
+			if arg_index + 1 < args.size():
+				next_value = str(args[arg_index + 1]).strip_edges()
+			if next_value != "" and not next_value.begins_with("--"):
+				ui_staging_mode = next_value.to_lower()
+			else:
+				ui_staging_mode = ""
+		elif value.begins_with("--ui-staging="):
+			ui_staging_mode = value.trim_prefix("--ui-staging=").strip_edges().to_lower()
+
+
+func _ui_staging_is_image2() -> bool:
+	return ui_staging_mode == "image2"
+
