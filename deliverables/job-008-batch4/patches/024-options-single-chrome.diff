 	_add_approved_ui_wiring_b2_text_action(view, "ui_wiring_b2_options_language", Rect2(470.0, 548.0, 185.0, 40.0), "言語・テキスト", Callable(self, "_select_approved_b2_options_category").bind("language"), false, &"tab")
