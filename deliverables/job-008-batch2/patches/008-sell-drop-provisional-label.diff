+func _shop_item_product_display_name(item: Dictionary) -> String:
+	# shops.json gift placeholders still carry a "[仮]" prefix. Sell rows were
+	# drawing that debug label over the icon band (job-004 08). Do not invent a
+	# hide if the approved PNG is also baked; just stop the live text.
+	var name := _shop_item_display_name(item)
+	if name.begins_with("[仮]"):
+		return name.substr(3).strip_edges()
+	return name
+
+
 func _item_category_label(item_type: String) -> String:
