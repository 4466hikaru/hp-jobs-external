+func _legacy_combat_hud_replaced() -> bool:
+	# UiIdealBatch1/CombatHudSlots is the live combat HUD. hud_panel is the
+	# leftover Control painter that _update_hud keeps re-showing.
+	if ui_layer == null:
+		return false
+	var slots := ui_layer.get_node_or_null("CombatHudSlots") as Control
+	return slots != null and is_instance_valid(slots)
