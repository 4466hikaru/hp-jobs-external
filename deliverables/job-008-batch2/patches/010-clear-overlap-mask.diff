+func _clip_approved_b2_result_action(view: Control, node_name: String, rect: Rect2) -> void:
+	# Result extra-actions reuse the 340x80 / 350x105 next/retry crop.  When
+	# TextureRect restores that native minimum, the banner overlaps neighbors
+	# and its cleared interior reads as a black mask.  Clip to the live rect
+	# and keep the label above the crop (align / clip / z-order only).
+	if view == null:
+		return
+	var component := view.get_node_or_null("ApprovedB2Component_%s" % node_name) as TextureRect
+	if component != null and component.get_parent() == view:
+		var clip := Control.new()
+		clip.name = "ApprovedB2Clip_%s" % node_name
+		clip.position = rect.position
+		clip.size = rect.size
+		clip.clip_contents = true
+		clip.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		clip.z_index = 1
+		view.remove_child(component)
+		component.position = Vector2.ZERO
+		component.size = rect.size
+		component.custom_minimum_size = Vector2.ZERO
+		component.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		component.stretch_mode = TextureRect.STRETCH_SCALE
+		clip.add_child(component)
+		view.add_child(clip)
+	var button := view.get_node_or_null(node_name) as Button
+	if button != null:
+		button.position = rect.position
+		button.size = rect.size
+		button.alignment = HORIZONTAL_ALIGNMENT_CENTER
+		button.z_index = 2
+
+
